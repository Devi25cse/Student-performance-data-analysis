# Week 3 - Data Modelling
# Student: DEVI M
# College: Sir Isaac Newton College of Engineering and Technology
#
# Dataset: UCI Student Performance - Mathematics (student-mat.csv)
# Target: G3 (final grade)
#
# This script:
# 1. Loads and checks the dataset
# 2. Encodes categorical variables
# 3. Splits the data into training/testing sets
# 4. Trains Linear Regression and Random Forest models
# 5. Evaluates MAE, RMSE and R²
# 6. Performs 5-fold cross-validation
# 7. Creates model-comparison and prediction-diagnostic plots
# 8. Displays Random Forest feature importance

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split, KFold, cross_val_score
from sklearn.preprocessing import OrdinalEncoder, StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.linear_model import LinearRegression
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

RANDOM_STATE = 42

# -----------------------------
# 1. Load data
# -----------------------------
df = pd.read_csv("student-mat.csv", sep=";")

print("Dataset shape:", df.shape)
print("Missing values:", df.isnull().sum().sum())
print("Duplicate rows:", df.duplicated().sum())

# -----------------------------
# 2. Basic cleaning
# -----------------------------
df = df.drop_duplicates().reset_index(drop=True)

# Normalize text fields
object_cols = df.select_dtypes(include="object").columns
for col in object_cols:
    df[col] = df[col].astype(str).str.strip()

# -----------------------------
# 3. Encode categorical data
# -----------------------------
df_reg = df.copy()

categorical_columns = [
    c for c in df_reg.columns if df_reg[c].dtype == "object"
]

# One-hot encode multi-category columns
for col, prefix in [
    ("Mjob", "m_"),
    ("Fjob", "f_"),
    ("reason", "r_"),
    ("guardian", "g_")
]:
    df_reg[col] = df_reg[col].apply(lambda v: prefix + v)

dummies = pd.concat(
    [
        pd.get_dummies(df_reg["Fjob"]),
        pd.get_dummies(df_reg["Mjob"]),
        pd.get_dummies(df_reg["reason"]),
        pd.get_dummies(df_reg["guardian"])
    ],
    axis=1
)

df_reg = pd.concat([df_reg, dummies], axis=1)
df_reg = df_reg.drop(["Mjob", "Fjob", "reason", "guardian"], axis=1)

bool_cols = df_reg.select_dtypes(include="bool").columns
df_reg[bool_cols] = df_reg[bool_cols].astype(int)

# Ordinal-encode the remaining categorical columns
binary_cols = [
    c for c in categorical_columns
    if c not in ["Mjob", "Fjob", "reason", "guardian"]
]

encoder = OrdinalEncoder()
df_reg[binary_cols] = encoder.fit_transform(
    df_reg[binary_cols]
).astype(int)

# -----------------------------
# 4. Feature/target split
# -----------------------------
X = df_reg.drop("G3", axis=1)
y = df_reg["G3"]

print("Feature matrix:", X.shape)
print("Target:", y.name)

# -----------------------------
# 5. Train/test split
# -----------------------------
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=RANDOM_STATE
)

# -----------------------------
# 6. Evaluation function
# -----------------------------
cv = KFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)

def evaluate_model(name, model):
    model.fit(X_train, y_train)
    pred = model.predict(X_test)

    mae = mean_absolute_error(y_test, pred)
    rmse = np.sqrt(mean_squared_error(y_test, pred))
    r2 = r2_score(y_test, pred)

    cv_scores = cross_val_score(
        model, X_train, y_train, cv=cv, scoring="r2"
    )

    print("\n", name)
    print("MAE:", round(mae, 3))
    print("RMSE:", round(rmse, 3))
    print("Test R2:", round(r2, 3))
    print("CV R2 Mean:", round(cv_scores.mean(), 3))
    print("CV R2 Std:", round(cv_scores.std(), 3))

    return {
        "Model": name,
        "MAE": mae,
        "RMSE": rmse,
        "Test R2": r2,
        "CV R2 Mean": cv_scores.mean(),
        "CV R2 Std": cv_scores.std(),
        "Predictions": pred,
        "ModelObject": model
    }

# -----------------------------
# 7. Models
# -----------------------------
linear_model = Pipeline([
    ("scaler", StandardScaler()),
    ("model", LinearRegression())
])

rf_model = RandomForestRegressor(
    n_estimators=300,
    min_samples_leaf=3,
    random_state=RANDOM_STATE,
    n_jobs=-1
)

linear_result = evaluate_model("Linear Regression", linear_model)
rf_result = evaluate_model("Random Forest", rf_model)

results = pd.DataFrame([
    {k: v for k, v in linear_result.items()
     if k not in ["Predictions", "ModelObject"]},
    {k: v for k, v in rf_result.items()
     if k not in ["Predictions", "ModelObject"]}
])

print("\nModel comparison:")
print(results.round(3).to_string(index=False))

# -----------------------------
# 8. Model comparison chart
# -----------------------------
results_plot = results.set_index("Model")[["MAE", "RMSE", "Test R2"]]
results_plot.plot(kind="bar", figsize=(9, 5))
plt.title("Model Performance Comparison")
plt.ylabel("Metric value")
plt.xticks(rotation=15)
plt.tight_layout()
plt.savefig("week3_model_comparison.png", dpi=180)
plt.show()

# -----------------------------
# 9. Actual vs Predicted
# -----------------------------
best_pred = rf_result["Predictions"]

plt.figure(figsize=(7, 6))
plt.scatter(y_test, best_pred, alpha=0.65)
lims = [min(y_test.min(), best_pred.min()) - 1,
        max(y_test.max(), best_pred.max()) + 1]
plt.plot(lims, lims, "--")
plt.xlabel("Actual G3")
plt.ylabel("Predicted G3")
plt.title("Random Forest - Actual vs Predicted G3")
plt.tight_layout()
plt.savefig("week3_actual_vs_predicted.png", dpi=180)
plt.show()

# -----------------------------
# 10. Residual plot
# -----------------------------
residuals = y_test - best_pred

plt.figure(figsize=(7, 5))
plt.scatter(best_pred, residuals, alpha=0.65)
plt.axhline(0, linestyle="--")
plt.xlabel("Predicted G3")
plt.ylabel("Residual (Actual - Predicted)")
plt.title("Random Forest - Residual Analysis")
plt.tight_layout()
plt.savefig("week3_residuals.png", dpi=180)
plt.show()

# -----------------------------
# 11. Feature importance
# -----------------------------
rf_fitted = rf_result["ModelObject"]
importance = (
    pd.Series(rf_fitted.feature_importances_, index=X_train.columns)
    .sort_values(ascending=False)
)

print("\nTop 12 Random Forest features:")
print(importance.head(12))

plt.figure(figsize=(8, 5))
importance.head(12).sort_values().plot(kind="barh")
plt.xlabel("Feature Importance")
plt.title("Random Forest - Top 12 Features")
plt.tight_layout()
plt.savefig("week3_feature_importance.png", dpi=180)
plt.show()
